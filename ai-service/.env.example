AI_SERVICE_PORT=8081
# Kirim pesan dan konteks sesi ke model untuk chat personal.
AI_COMPANION_ENABLED=true
# Ollama lokal. Pilih tag yang tersedia di "ollama list".
AI_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
AI_LLM_MODEL=qwen3.5:9b
# Isi hanya untuk provider HTTPS yang memerlukan autentikasi.
AI_LLM_API_KEY=
